{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npx prisma generate --schema=packages/database/prisma/schema.prisma && npx turbo run build --filter=@mizpah-pulse/web",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_STELLAR_NETWORK": "TESTNET",
    "NEXT_PUBLIC_PULSE_CONTRACT_ID": "@pulse-contract-id"
  },
  "github": {
    "enabled": true,
    "autoJobCancelation": true
  }
}
