{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (next dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "restart": true,
      "sourceMaps": true
    },
    {
      "name": "WS (tsx watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/ws",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "name": "Ingester (tsx watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/ingester",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "All apps",
      "configurations": ["Web (next dev)", "WS (tsx watch)", "Ingester (tsx watch)"]
    }
  ]
}
