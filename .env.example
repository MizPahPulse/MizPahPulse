# ──────────────────────────────────────────────
# MizPahPulse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://mizpah:mizpah_dev@localhost:5432/mizpah_pulse

# ── Redis ─────────────────────────────────────
# Redis connection URL (BullMQ queue + Pub/Sub)
REDIS_URL=redis://localhost:6379

# ── Stellar Network ───────────────────────────
# Network to connect to: TESTNET | PUBLIC | FUTURENET | SANDBOX
STELLAR_NETWORK=TESTNET

# Horizon API URL (optional — auto-derived from STELLAR_NETWORK)
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL (optional — auto-derived from STELLAR_NETWORK)
# STELLAR_SOROBAN_RPC_URL=https://soroban-rpc.testnet.stellar.org

# ── Pulse Smart Contract ──────────────────────
# Deployed PulseContract ID on Stellar Testnet
# Set after running: npx tsx scripts/deploy-contract.ts
NEXT_PUBLIC_PULSE_CONTRACT_ID=CC4HXCVIOPUOS2UJFLTM6WP2ESNSWM4BGJ26XR4SRRVB74TOZMC7EE2C

# ── WebSocket Server ──────────────────────────
# URL of the WebSocket server (for the frontend client)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# CORS origin for the WebSocket server
CORS_ORIGIN=http://localhost:3000

# WebSocket server port (default: 3001)
WS_PORT=3001

# ── Contract Deployment ───────────────────────
# Secret key of a funded Stellar Testnet account
# Generate one: https://laboratory.stellar.org/#account-creator?network=test
DEPLOYER_SECRET=S...

# ── Security ──────────────────────────────────
# Secret for signing webhook payloads
WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Secret for signing JWTs
JWT_SECRET=dev-jwt-secret-change-in-production

# Secret for API key generation
API_KEY_SECRET=dev-api-key-secret-change-in-production

# ── App (Next.js) ─────────────────────────────
# Node environment
NODE_ENV=development

# Public Stellar network for the frontend
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Prisma log level
PRISMA_LOG_LEVEL=info

# ── Mock API Mode (issue #100) ───────────────
# Set MOCK_API=1 to run the web API WITHOUT Postgres/Redis. API routes serve
# deterministic in-memory sample data using the same response shapes as the
# real Prisma client — great for quick UI/demo work or when you can't run
# Docker:
#   MOCK_API=1 npm run dev -w apps/web
MOCK_API=0

# ── Event Retention ──────────────────────────
# Number of days to keep events in the database. When set, the ingester
# prunes events older than this on startup and every 6 hours. Unset, empty,
# or 0 disables pruning (default).
# EVENT_RETENTION_DAYS=90

# ── Error Tracking (Sentry, issue #76) ────────
# Set SENTRY_DSN to enable centralized error tracking for the web app and
# the ingester. When unset, all Sentry integration is disabled.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
#
# Release tagging: the git SHA is read from GIT_SHA (then VERCEL_GIT_COMMIT_SHA),
# falling back to `git rev-parse HEAD` at runtime.
# GIT_SHA=0123456789abcdef0123456789abcdef01234567
#
# Optional sampling rate for performance traces (0.0–1.0, default 0.1).
# SENTRY_TRACES_SAMPLE_RATE=0.1
